---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news
    .filter((item) => item.body.trim() && item.body.trim() !== item.data.summary.trim())
    .map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${item.data.title} - 实验室动态`} description={item.data.summary}>
  <Header />
  <main class="min-h-screen bg-slate-50 pt-28">
    <article class="mx-auto max-w-4xl px-6 py-12 md:py-16">
      <a href={`${base}/news`} class="text-sm font-semibold text-indigo-600 hover:text-indigo-800">← 返回实验室动态</a>
      <div class="mt-7">
        <NewsCard
          date={item.data.date.toISOString().split('T')[0]}
          title={item.data.title}
          summary={item.data.summary}
          image={item.data.image}
          images={item.data.images}
          category={item.data.category}
          imageDisplay="detail"
        />
      </div>
      <div class="news-content mt-8 rounded-2xl border border-slate-200 bg-white px-7 py-8 text-slate-700 shadow-sm md:px-12 md:py-10">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .news-content :global(h2){margin-top:2rem;font-size:1.4rem;font-weight:700;color:#172033}
  .news-content :global(h3){margin-top:1.5rem;font-size:1.15rem;font-weight:700;color:#172033}
  .news-content :global(p){margin-top:1rem;white-space:pre-line;line-height:1.9}
  .news-content :global(ul),.news-content :global(ol){margin-top:1rem;padding-left:1.4rem;line-height:1.8}
  .news-content :global(ul){list-style:disc}.news-content :global(ol){list-style:decimal}
  .news-content :global(li){margin-top:.45rem}.news-content :global(strong){font-weight:700;color:#1e293b}
  .news-content :global(a){color:#4f46e5;text-decoration:underline}
</style>
