---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { visiblePublications } from '../publications';

const labPublications = visiblePublications.filter((publication) => publication.scope === 'lab');
const piPublications = visiblePublications.filter((publication) => publication.scope !== 'lab');
---

<Layout title="论文发表" description="Wu Lab 课题组研究成果及吴惊香研究员代表论文">
  <Header />
  <main class="bg-[#f7f8fc] min-h-screen">
    <section class="pt-32 pb-16">
      <div class="max-w-6xl mx-auto px-6">
        <span class="text-xs font-bold uppercase tracking-[.2em] text-indigo-600">Publications</span>
        <div class="mt-4 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div><h1 class="text-5xl md:text-6xl font-bold tracking-tight text-slate-950">研究成果</h1><p class="mt-4 max-w-2xl text-lg text-slate-600">区分课题组成立后的研究成果与吴惊香研究员代表性工作，作者姓名加粗表示本组成员。</p></div>
          <div class="flex gap-3"><div class="rounded-2xl border border-indigo-100 bg-indigo-50 px-5 py-3"><strong class="text-2xl text-indigo-700">{labPublications.length}</strong><span class="ml-2 text-sm text-indigo-700">课题组成果</span></div><div class="rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-3"><strong class="text-2xl text-emerald-700">{piPublications.length}</strong><span class="ml-2 text-sm text-emerald-700">吴老师代表作</span></div></div>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="mb-7 flex items-center gap-4"><span class="h-3 w-3 rounded-full bg-indigo-600"></span><h2 class="text-2xl font-bold text-slate-900">课题组发表</h2><span class="text-sm text-slate-400">Wu Lab publications</span></div>
        {labPublications.length ? <div class="space-y-5">{labPublications.map((publication) => <PublicationItem {...publication} />)}</div> : <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">后台中尚未设置“课题组成立后成果”。</div>}
      </div>
    </section>

    {piPublications.length > 0 && <section class="border-t border-slate-200 bg-white py-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="mb-7 flex items-center gap-4"><span class="h-3 w-3 rounded-full bg-emerald-500"></span><h2 class="text-2xl font-bold text-slate-900">吴惊香研究员代表作</h2><span class="text-sm text-slate-400">Selected earlier work</span></div>
        <div class="space-y-5">{piPublications.map((publication) => <PublicationItem {...publication} />)}</div>
      </div>
    </section>}
  </main>
  <Footer />
</Layout>
