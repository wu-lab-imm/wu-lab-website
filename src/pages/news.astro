---
// 新闻动态页 - news.astro

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';

// 获取所有新闻并按日期排序
const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// 按月份分组
const newsByMonth = sortedNews.reduce((acc, news) => {
  const date = new Date(news.data.date);
  const monthKey = `${date.getFullYear()}年${date.getMonth() + 1}月`;
  if (!acc[monthKey]) {
    acc[monthKey] = [];
  }
  acc[monthKey].push(news);
  return acc;
}, {} as Record<string, typeof sortedNews>);

const months = Object.keys(newsByMonth);
---

<Layout title="新闻动态" description="Wu Lab的最新研究进展、获奖信息和学术动态">
  <Header />

  <main>
    <!-- 页面标题 -->
    <section class="bg-white pt-28 pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          实验室动态 <span class="text-gray-500">| News & Events</span>
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          了解课题组的最新动态
        </p>
      </div>
    </section>

    <!-- 时间线布局新闻列表 -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        {months.map((month) => (
          <div class="mb-16">
            <!-- 月份标题 -->
            <h2 class="text-xl font-bold text-gray-900 mb-8 flex items-center">
              <span class="text-gray-900 font-bold px-2 mr-4">{month}</span>
                          </h2>

            <!-- 时间线 -->
            <div class="relative">
              <!-- 时间线竖线 -->
              <div class="absolute left-0 top-0 bottom-0 w-0.5 bg-gray-200"></div>

              <!-- 新闻列表 -->
              <div class="space-y-8 ml-6">
                {newsByMonth[month].map((news) => (
                  <div class="relative">
                    <!-- 时间线点 -->
                    <div class="absolute -left-[31px] top-6 w-4 h-4 bg-gray-400 rounded-full border-4 border-white shadow-md"></div>

                    <NewsCard
                      date={news.data.date.toISOString().split('T')[0]}
                      title={news.data.title}
                      summary={news.data.summary}
                      image={news.data.image}
                      images={news.data.images}
                      category={news.data.category}
                    />
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
