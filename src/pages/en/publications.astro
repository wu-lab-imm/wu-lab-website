---
import Layout from '../../layouts/Layout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';import PublicationItem from '../../components/PublicationItem.astro';import {visiblePublications} from '../../publications';
const lab=visiblePublications.filter(p=>p.scope==='lab');const pi=visiblePublications.filter(p=>p.scope!=='lab');
---
<Layout lang="en" title="Publications" description="Publications from the Wu Lab and selected earlier work by Jing-xiang Wu"><Header lang="en" /><main class="min-h-screen bg-[#f7f8fc]"><section class="pb-16 pt-32"><div class="mx-auto max-w-6xl px-6"><span class="text-xs font-bold uppercase tracking-[.2em] text-indigo-600">Publications</span><h1 class="mt-4 text-6xl font-bold text-slate-950">Research Output</h1><p class="mt-4 max-w-2xl text-lg text-slate-600">Publications from the Wu Lab and selected earlier work by Principal Investigator Jing-xiang Wu. Bold author names indicate laboratory members.</p></div></section><section class="mx-auto max-w-6xl px-6 pb-16"><h2 class="mb-7 text-2xl font-bold">Wu Lab Publications <span class="text-base font-normal text-slate-400">({lab.length})</span></h2><div class="space-y-5">{lab.map(p=><PublicationItem {...p} lang="en"/>)}</div></section>{pi.length>0&&<section class="border-t border-slate-200 bg-white py-16"><div class="mx-auto max-w-6xl px-6"><h2 class="mb-7 text-2xl font-bold">Selected Earlier Work <span class="text-base font-normal text-slate-400">({pi.length})</span></h2><div class="space-y-5">{pi.map(p=><PublicationItem {...p} lang="en"/>)}</div></div></section>}</main><Footer lang="en" /></Layout>
