---
import Layout from '../../layouts/Layout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';import {getCollection} from 'astro:content';
const items=(await getCollection('research')).filter(i=>i.data.titleEn&&i.data.descriptionEn).sort((a,b)=>a.data.order-b.data.order);const base=import.meta.env.BASE_URL.replace(/\/$/,'');const imageUrl=(p:string)=>p.startsWith(base+'/')?p:p.startsWith('/images/')?base+p:p;
---
<Layout lang="en" title="Research" description="Research directions of the Wu Lab"><Header lang="en" /><main><section class="bg-white pb-20 pt-28 text-center"><div class="mx-auto max-w-5xl px-6"><h1 class="text-5xl font-bold text-gray-900">Research</h1><p class="mx-auto mt-5 max-w-3xl text-xl leading-relaxed text-gray-600">We use structural and mechanistic approaches to understand disease-related proteins, membrane-embedded machineries, and glycan biology.</p></div></section><section class="bg-gray-50 py-20"><div class="mx-auto max-w-7xl space-y-12 px-6">{items.map((item,index)=><article class="overflow-hidden rounded-2xl bg-white shadow-md"><div class="grid lg:grid-cols-2"><div class:list={['flex items-center justify-center bg-gray-100',index%2?'lg:order-2':'']} >{item.data.image?<img src={imageUrl(item.data.image)} alt={item.data.titleEn} class="max-h-[500px] w-full object-contain"/>:<span class="p-20 text-8xl">{item.data.icon}</span>}</div><div class:list={['flex flex-col justify-center p-8 lg:p-12',index%2?'lg:order-1':'']}><h2 class="text-3xl font-bold text-gray-900">{item.data.titleEn}</h2><p class="mt-6 text-lg leading-relaxed text-gray-600">{item.data.descriptionEn}</p>{item.data.detailsEn&&<p class="mt-5 whitespace-pre-line leading-relaxed text-gray-600">{item.data.detailsEn}</p>}<a href={`${base}/en/publications`} class="mt-7 font-semibold text-indigo-600">Related publications →</a></div></div></article>)}</div></section></main><Footer lang="en" /></Layout>
