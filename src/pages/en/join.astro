---
import Layout from '../../layouts/Layout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';import content from '../../join.json';
const positions=content.positionsEn||[],steps=content.applicationStepsEn||[],environment=content.environmentEn||[],contact=content.contactEn;
---
<Layout lang="en" title="Join Us" description="Open positions and application information for the Wu Lab"><Header lang="en" /><main class="min-h-screen bg-[#f7f8fc]"><section class="bg-slate-950 pb-20 pt-36 text-center text-white"><div class="mx-auto max-w-4xl px-6"><span class="text-xs font-bold uppercase tracking-[.25em] text-emerald-400">Join the Wu Lab</span><h1 class="mt-5 text-5xl font-bold">Work with Us</h1><p class="mx-auto mt-6 max-w-3xl text-xl leading-relaxed text-slate-300">{content.headlineEn}</p></div></section><section class="mx-auto max-w-6xl space-y-8 px-6 py-16">{positions.map(p=><article class="overflow-hidden rounded-2xl bg-white shadow-sm"><div class="bg-indigo-600 px-8 py-5 text-white"><h2 class="text-2xl font-bold">{p.title}</h2>{p.titleEn&&p.titleEn!==p.title&&<p class="mt-1 text-sm text-white/75">{p.titleEn}</p>}</div><div class="p-8"><div class="grid gap-8 md:grid-cols-2"><div><h3 class="font-bold text-indigo-700">Requirements</h3><ul class="mt-4 list-disc space-y-2 pl-5 text-slate-600">{p.requirements.map(x=><li>{x}</li>)}</ul></div><div><h3 class="font-bold text-indigo-700">Research Directions</h3><ul class="mt-4 list-disc space-y-2 pl-5 text-slate-600">{p.directions?.map(x=><li>{x}</li>)}</ul>{p.benefits&&<><h3 class="mt-6 font-bold text-indigo-700">What We Offer</h3><ul class="mt-4 list-disc space-y-2 pl-5 text-slate-600">{p.benefits.map(x=><li>{x}</li>)}</ul></>}</div></div>{p.link&&<div class="mt-7 border-t border-slate-100 pt-6"><a href={p.link} target="_blank" rel="noreferrer" class="inline-flex items-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white hover:bg-indigo-700">{p.linkLabel||'View official recruitment announcement'} ↗</a></div>}</div></article>)}</section><section class="bg-indigo-50 py-16"><div class="mx-auto max-w-6xl px-6"><h2 class="text-center text-4xl font-bold">How to Apply</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{steps.map((s,i)=><div class="rounded-2xl bg-white p-7 shadow-sm"><span class="text-sm font-bold text-indigo-600">STEP {i+1}</span><h3 class="mt-5 text-xl font-bold">{s.title}</h3><p class="mt-3 leading-relaxed text-slate-600">{s.description}</p></div>)}</div></div></section><section class="py-16"><div class="mx-auto max-w-6xl px-6"><h2 class="text-center text-4xl font-bold">Research Environment</h2><div class="mt-10 grid gap-5 md:grid-cols-5">{environment.map(e=><div class="rounded-2xl bg-white p-5 text-center shadow-sm"><span class="text-4xl">{e.icon}</span><h3 class="mt-4 font-bold">{e.title}</h3><p class="mt-2 text-sm text-slate-500">{e.description}</p></div>)}</div><div class="mt-16 rounded-3xl bg-slate-950 p-9 text-center text-white"><h2 class="text-3xl font-bold">Contact</h2><p class="mt-4">{contact.name} · <a class="text-emerald-400" href={`mailto:${contact.email}`}>{contact.email}</a></p><p class="mt-3 text-slate-400">{contact.address}</p><p class="mt-4 text-slate-300">{contact.message}</p></div></div></section></main><Footer lang="en" /></Layout>
