---
import Layout from '../../layouts/Layout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';import NewsCard from '../../components/NewsCard.astro';import {getCollection} from 'astro:content';
const news=(await getCollection('news')).filter(n=>n.data.titleEn&&n.data.summaryEn).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<Layout lang="en" title="News & Events" description="Latest research and events from the Wu Lab"><Header lang="en" /><main><section class="bg-white pb-16 pt-32 text-center"><h1 class="text-5xl font-bold text-gray-900">News & Events</h1><p class="mt-4 text-xl text-gray-600">Research highlights, milestones, and life in the Wu Lab</p></section><section class="bg-slate-50 py-16"><div class="mx-auto grid max-w-6xl gap-8 px-6 md:grid-cols-2">{news.map(n=><NewsCard lang="en" date={n.data.date.toISOString().split('T')[0]} title={n.data.titleEn!} summary={n.data.summaryEn!} image={n.data.image} images={n.data.images} category={n.data.category} link={n.data.bodyEn?`${base}/en/news/${n.slug}`:undefined} imageDisplay="wide"/>)}</div></section></main><Footer lang="en" /></Layout>
