---
import Layout from '../../layouts/Layout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';import PersonCard from '../../components/PersonCard.astro';import {getCollection} from 'astro:content';
const people=(await getCollection('people')).sort((a,b)=>a.data.order-b.data.order);const groups=[['PI','Principal Investigator'],['ResearchAssistant','Research Assistants'],['Postdoc','Postdoctoral Fellows'],['PhD','Ph.D. Students'],['Master',"Master's Students"],['Undergraduate','Undergraduate Students'],['Alumni','Alumni']] as const;
---
<Layout lang="en" title="People" description="Members of the Wu Lab"><Header lang="en" /><main class="min-h-screen bg-slate-50"><section class="bg-white pb-16 pt-32 text-center"><h1 class="text-5xl font-bold text-gray-900">People</h1><p class="mt-4 text-xl text-gray-600">Meet the Wu Lab team</p></section>{groups.map(([role,label])=>{const members=people.filter(p=>p.data.role===role);return members.length?<section class="border-t border-slate-100 py-14"><div class="mx-auto max-w-7xl px-6"><h2 class="mb-8 text-3xl font-bold text-slate-900">{label}</h2><div class:list={['grid gap-6',role==='PI'?'max-w-sm grid-cols-1':'grid-cols-2 md:grid-cols-3 lg:grid-cols-4']}>{members.map(p=><PersonCard lang="en" slug={p.slug} name={p.data.nameEn||p.data.name} role={p.data.role} photo={p.data.photo} email={p.data.email} researchInterest={p.data.researchInterestEn} startYear={p.data.startYear} graduationYear={p.data.graduationYear} position={p.data.position} positionEn={p.data.positionEn}/>)}</div></div></section>:null})}</main><Footer lang="en" /></Layout>
