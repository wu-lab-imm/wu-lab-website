---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';
const allNews=(await getCollection('news')).filter(n=>n.data.titleEn&&n.data.summaryEn).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const featured=allNews.filter(n=>n.data.featured);const homeNews=(featured.length?featured:allNews).slice(0,6);const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const detail=(n:typeof allNews[number])=>n.data.bodyEn?`${base}/en/news/${n.slug}`:undefined;
---
<Layout lang="en" title="Wu Lab - Structural Biology and Glycobiology" description="Wu Lab studies disease-related protein machines, structural pharmacology, and glycobiology.">
  <Header lang="en" />
  <main><Hero lang="en" labName="Jing-xiang Wu Laboratory" subtitle="Institute of Materia Medica, Chinese Academy of Medical Sciences & Peking Union Medical College" description="We combine cryo-electron microscopy, X-ray crystallography, biochemistry, and cellular approaches to understand disease-related proteins and mechanisms of drug action." /><section class="border-t border-slate-100 bg-white py-20"><div class="mx-auto max-w-7xl px-6"><div class="mb-10 flex items-end justify-between gap-5"><div><span class="text-xs font-bold uppercase tracking-[.2em] text-indigo-600">Featured news</span><h2 class="mt-2 text-4xl font-bold text-slate-950">Latest from the Lab</h2><p class="mt-3 text-slate-500">Research highlights and laboratory updates</p></div><a href={`${base}/en/news`} class="font-semibold text-indigo-600">View all news →</a></div><div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">{homeNews.map(n=><NewsCard lang="en" date={n.data.date.toISOString().split('T')[0]} title={n.data.titleEn!} summary={n.data.summaryEn!} image={n.data.image||n.data.images?.[0]} category={n.data.category} link={detail(n)} priority />)}</div></div></section></main>
  <Footer lang="en" />
</Layout>
