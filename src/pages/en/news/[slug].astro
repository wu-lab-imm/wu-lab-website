---
import Layout from '../../../layouts/Layout.astro';import Header from '../../../components/Header.astro';import Footer from '../../../components/Footer.astro';import NewsCard from '../../../components/NewsCard.astro';import {getCollection} from 'astro:content';
export async function getStaticPaths(){const news=await getCollection('news');return news.filter(n=>n.data.bodyEn&&n.data.titleEn&&n.data.summaryEn).map(item=>({params:{slug:item.slug},props:{item}}))}
const {item}=Astro.props;const base=import.meta.env.BASE_URL.replace(/\/$/,'');const blocks=(item.data.bodyEn||'').split(/\n\s*\n/).filter(Boolean);
---
<Layout lang="en" title={`${item.data.titleEn} - News`} description={item.data.summaryEn}><Header lang="en" /><main class="min-h-screen bg-slate-50 pt-28"><article class="mx-auto max-w-4xl px-6 py-12"><a href={`${base}/en/news`} class="text-sm font-semibold text-indigo-600">← Back to News</a><div class="mt-7"><NewsCard lang="en" date={item.data.date.toISOString().split('T')[0]} title={item.data.titleEn!} summary={item.data.summaryEn!} image={item.data.image} images={item.data.images} category={item.data.category} imageDisplay="detail"/></div><div class="mt-8 rounded-2xl border border-slate-200 bg-white px-8 py-10 shadow-sm">{blocks.map(block=>block.startsWith('## ')?<h2 class="mt-8 text-2xl font-bold text-slate-900 first:mt-0">{block.slice(3)}</h2>:<p class="mt-4 leading-8 text-slate-700">{block}</p>)}</div></article></main><Footer lang="en" /></Layout>
