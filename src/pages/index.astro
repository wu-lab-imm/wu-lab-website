---
// 首页 - index.astro (简化版)

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const allNews = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredNews = allNews.filter((item) => item.data.featured);
const homeNews = (featuredNews.length ? featuredNews : allNews).slice(0, 6);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const detailLink = (news: typeof allNews[number]) => {
  const body = news.body.trim();
  return body && body !== news.data.summary.trim() ? `${base}/news/${news.slug}` : undefined;
};
---

<Layout title="Wu Lab - 结构生物学研究">
  <Header />

  <main>
    <!-- Hero Section -->
    <Hero />
    <section class="border-t border-slate-100 bg-white py-20" id="news">
      <div class="mx-auto max-w-7xl px-6">
        <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div><span class="text-xs font-bold uppercase tracking-[.2em] text-indigo-600">Featured news</span><h2 class="mt-2 text-3xl font-bold text-slate-950 md:text-4xl">实验室最新动态</h2><p class="mt-3 text-slate-500">后台勾选“首页推荐”的新闻会显示在这里</p></div>
          <a href={`${base}/news`} class="font-semibold text-indigo-600 hover:text-indigo-800">查看全部新闻 →</a>
        </div>
        {homeNews.length ? <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">{homeNews.map((news) => <NewsCard date={news.data.date.toISOString().split('T')[0]} title={news.data.title} summary={news.data.summary} image={news.data.image || news.data.images?.[0]} category={news.data.category} link={detailLink(news)} />)}</div> : <div class="rounded-2xl border border-dashed border-slate-300 p-10 text-center text-slate-500">暂无新闻</div>}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
