---
// 团队成员页 - people.astro

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PersonCard from '../components/PersonCard.astro';
import { getCollection } from 'astro:content';

// 获取所有团队成员
const allPeople = await getCollection('people');
const sortedPeople = allPeople.sort((a, b) => a.data.order - b.data.order);

// 按角色分组
const pi = sortedPeople.filter(p => p.data.role === 'PI');
const postdocs = sortedPeople.filter(p => p.data.role === 'Postdoc');
const phds = sortedPeople.filter(p => p.data.role === 'PhD');
const masters = sortedPeople.filter(p => p.data.role === 'Master');
const researchAssistants = sortedPeople.filter(p => p.data.role === 'ResearchAssistant');
const undergrads = sortedPeople.filter(p => p.data.role === 'Undergraduate');
const alumni = sortedPeople.filter(p => p.data.role === 'Alumni');
---

<style>
  /* 代表性成果列表滚动条 */
  .publications-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .publications-scroll::-webkit-scrollbar-track {
    background: #f3f4f6;
    border-radius: 3px;
  }
  .publications-scroll::-webkit-scrollbar-thumb {
    background: #d6d3d1;
    border-radius: 3px;
  }
  .publications-scroll::-webkit-scrollbar-thumb:hover {
    background: #a8a29e;
  }
</style>

<Layout title="团队成员 - People">
  <Header />

  <main>
    <!-- 页面标题 -->
    <section class="bg-white pt-28 pb-20 border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          团队成员 <span class="text-gray-500">| People</span>
        </h1>
        <p class="text-xl text-gray-600">
          Wu Lab 课题组成员介绍
        </p>
      </div>
    </section>

    <!-- PI Section - 突出显示 -->
    {pi.length > 0 && (
      <section class="py-20 bg-gradient-to-b from-gray-50 to-white">
        <div class="max-w-6xl mx-auto px-6">
          <h2 class="text-2xl md:text-3xl font-bold mb-10 flex items-center justify-center">
            <span class="text-gray-900">课题组长</span>
            <span class="text-gray-300 mx-4">|</span>
            <span class="text-amber-600 font-display">Principal Investigator</span>
          </h2>

          <!-- 课题组长卡片 - 与下方网格对齐 -->
          <div class="bg-white rounded-2xl shadow-xl overflow-hidden group">
            <div class="grid grid-cols-1 lg:grid-cols-4">
              <!-- 左侧照片区域 -->
              <div class="lg:col-span-1 bg-gradient-to-br from-gray-100 to-gray-200 p-8 flex flex-col items-center justify-center">
                <div class="relative w-full">
                  <div class="absolute inset-0 bg-amber-400 rounded-2xl opacity-0 group-hover:opacity-20 transition-opacity duration-500 blur-xl"></div>
                  <img
                    src="https://www.imm.ac.cn/images/2023-03/e4e5696ac2094384b1cd22c27743eb8e.png"
                    alt="吴惊香"
                    class="relative w-full h-auto object-contain rounded-2xl shadow-lg"
                  />
                </div>
                <!-- 照片下方联系信息 -->
                <div class="mt-6 space-y-2 w-full max-w-[200px]">
                  <p class="text-sm text-gray-600"><span class="font-medium">职称：</span>助理教授</p>
                  <p class="text-sm text-gray-600"><span class="font-medium">导师类别：</span>博士生导师</p>
                  <p class="text-sm text-gray-600"><span class="font-medium">科室：</span>天然药物活性物质与功能国家重点实验室</p>
                  <p class="text-sm text-gray-600">
                    <span class="font-medium">联系：</span>
                    <a href="mailto:wujingxiang@imm.ac.cn" class="text-amber-600 hover:text-amber-700">wujingxiang@imm.ac.cn</a>
                  </p>
                </div>
              </div>

              <!-- 右侧内容区域 -->
              <div class="lg:col-span-3 p-8 flex flex-col">
                <!-- 姓名和职称 -->
                <div class="mb-6">
                  <h3 class="text-4xl font-display font-bold text-gray-900 mb-2 group-hover:text-amber-600 transition-colors duration-300">吴惊香 <span class="text-xl font-normal text-gray-400">（Jingxiang Wu）</span></h3>
                  <p class="text-xl text-amber-600 font-medium">研究员/博士生导师</p>
                </div>

                <!-- 研究内容 -->
                <div class="mb-6">
                  <h4 class="text-sm font-bold text-amber-600 uppercase tracking-widest mb-3 flex items-center">
                    <span class="w-8 h-px bg-amber-500 mr-3"></span>
                    主要研究内容
                  </h4>
                  <p class="text-gray-600 leading-relaxed text-base">
                    长期从事疾病相关药物靶点蛋白的结构药理学研究，并基于结构研发药物。解析了神经系统疾病靶标——去甲肾上腺素转运体NET底物识别机制和抗抑郁药瑞达法辛药物作用机制；确定了代谢门控药靶KATP的组装模式，阐述了磺酰脲类和格列奈类药物的降糖机制；揭示了甲状腺氧化酶和脑特异激酶的调控机制；为相应靶标的药物研发提供了结构基础。承担6项国家和省部级科研课题，在Nature、Cell等杂志发表论文20余篇。参编教材1部，专著1部。
                  </p>
                </div>

                <!-- 教育/科研经历 -->
                <div class="mb-6">
                  <h4 class="text-sm font-bold text-amber-600 uppercase tracking-widest mb-4 flex items-center">
                    <span class="w-8 h-px bg-amber-500 mr-3"></span>
                    教育/科研经历
                  </h4>
                  <div class="relative pl-6 border-l-2 border-amber-400 space-y-4">
                    <div class="relative">
                      <div class="absolute -left-[31px] top-1 w-3 h-3 bg-amber-400 rounded-full border-2 border-white"></div>
                      <p class="font-bold text-gray-900">2022 至今</p>
                      <p class="text-gray-600">中国医学科学院药物研究所 · 研究员/博士生导师</p>
                    </div>
                    <div class="relative">
                      <div class="absolute -left-[31px] top-1 w-3 h-3 bg-amber-400 rounded-full border-2 border-white"></div>
                      <p class="font-bold text-gray-900">2016 - 2022</p>
                      <p class="text-gray-600">北京大学未来技术学院 · 博士后</p>
                    </div>
                    <div class="relative">
                      <div class="absolute -left-[31px] top-1 w-3 h-3 bg-amber-400 rounded-full border-2 border-white"></div>
                      <p class="font-bold text-gray-900">2009 - 2016</p>
                      <p class="text-gray-600">清华大学 · 博士</p>
                    </div>
                  </div>
                </div>

                <!-- 代表性成果 -->
                <div class="flex-1">
                  <h4 class="text-sm font-bold text-amber-600 uppercase tracking-widest mb-4 flex items-center">
                    <span class="w-8 h-px bg-amber-500 mr-3"></span>
                    代表性成果
                  </h4>
                  <div class="bg-gray-50 rounded-xl p-4 max-h-[180px] overflow-y-auto publications-scroll">
                    <ol class="space-y-3">
                      <li class="text-sm text-gray-700 leading-relaxed">
                        <span class="font-semibold">1.</span> Wenming Ji#, Anran Miao#, Kai Liang#, Jiameng Liu#, Yuhan Qi, Yue Zhou, Xinli Duan, Jixue Sun, Lipeng Lai, and Jing-Xiang Wu*. Substrate binding and inhibition mechanism of norepinephrine transporter. <em>Nature</em> 633(8029):473–79. (IF=48.5)
                      </li>
                      <li class="text-sm text-gray-700 leading-relaxed">
                        <span class="font-semibold">2.</span> Jing-Xiang Wu#, Rui Liu, Kangcheng Song, and Lei Chen*. Structures of human dual oxidase 1 complex in low-calcium and high-calcium states. <em>Nature Communications</em> 12(1):155–65. (IF=12.1)
                      </li>
                      <li class="text-sm text-gray-700 leading-relaxed">
                        <span class="font-semibold">3.</span> Dian Ding#, Mengmeng Wang#, Jing-Xiang Wu#, Yunlu Kang, and Lei Chen*. The Structural Basis for the Binding of Repaglinide to the Pancreatic K-ATP Channel. <em>Cell Reports</em> 27(6):1848–57. (IF=8.1)
                      </li>
                      <li class="text-sm text-gray-700 leading-relaxed">
                        <span class="font-semibold">4.</span> Jing-Xiang Wu#, Dian Ding, Mengmeng Wang, Yunlu Kang, Xin Zeng, and Lei Chen*. Ligand binding and conformational changes of SUR1 subunit in pancreatic ATP-sensitive potassium channels. <em>Protein & Cell</em> 9(6):553–67. (IF=10.2, F1000)
                      </li>
                      <li class="text-sm text-gray-700 leading-relaxed">
                        <span class="font-semibold">5.</span> Ningning Li#, Jing-Xiang Wu#, Dian Ding, Jiaxuan Cheng, Ning Gao*, and Lei Chen*. Structure of a Pancreatic ATP-Sensitive Potassium Channel. <em>Cell</em> 168(1):101–10. (IF=38.6, C100, F1000)
                      </li>
                      <li class="text-sm text-gray-700 leading-relaxed">
                        <span class="font-semibold">6.</span> Jing-Xiang Wu#, Yun-Sheng Cheng, Jue Wang, Lei Chen, Mei Ding, and Jia-Wei Wu*. Structural insight into the mechanism of synergistic autoinhibition of SAD kinases. <em>Nature Communications</em> 6:8953–64. (IF=12.1)
                      </li>
                    </ol>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 研究助理 Section - 移到博士后前面 -->
    {researchAssistants.length > 0 && (
      <section class="py-12">
        <div class="max-w-7xl mx-auto px-6">
          <h2 class="text-2xl md:text-3xl font-bold mb-8">
            <span class="text-gray-900">研究助理</span>
            <span class="text-gray-300 mx-3">|</span>
            <span class="text-amber-600">Research Assistants</span>
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {researchAssistants.map((person) => (
              <PersonCard
                name={person.data.name}
                nameEn={person.data.nameEn}
                role={person.data.role}
                photo={person.data.photo}
                email={person.data.email}
                researchInterest={person.data.researchInterest}
                startYear={person.data.startYear}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 博士后 Section -->
    {postdocs.length > 0 && (
      <section class="py-12 bg-gray-50">
        <div class="max-w-7xl mx-auto px-6">
          <h2 class="text-2xl md:text-3xl font-bold mb-8">
            <span class="text-gray-900">博士后</span>
            <span class="text-gray-300 mx-3">|</span>
            <span class="text-amber-600">Postdoctoral Fellows</span>
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {postdocs.map((person) => (
              <PersonCard
                name={person.data.name}
                nameEn={person.data.nameEn}
                role={person.data.role}
                photo={person.data.photo}
                email={person.data.email}
                researchInterest={person.data.researchInterest}
                startYear={person.data.startYear}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 博士研究生 Section -->
    {phds.length > 0 && (
      <section class="py-12">
        <div class="max-w-7xl mx-auto px-6">
          <h2 class="text-2xl md:text-3xl font-bold mb-8">
            <span class="text-gray-900">博士研究生</span>
            <span class="text-gray-300 mx-3">|</span>
            <span class="text-amber-600">PhD Students</span>
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {phds.map((person) => (
              <PersonCard
                name={person.data.name}
                nameEn={person.data.nameEn}
                role={person.data.role}
                photo={person.data.photo}
                email={person.data.email}
                researchInterest={person.data.researchInterest}
                startYear={person.data.startYear}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 硕士研究生 Section -->
    {masters.length > 0 && (
      <section class="py-12 bg-gray-50">
        <div class="max-w-7xl mx-auto px-6">
          <h2 class="text-2xl md:text-3xl font-bold mb-8">
            <span class="text-gray-900">硕士研究生</span>
            <span class="text-gray-300 mx-3">|</span>
            <span class="text-amber-600">Master Students</span>
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {masters.map((person) => (
              <PersonCard
                name={person.data.name}
                nameEn={person.data.nameEn}
                role={person.data.role}
                photo={person.data.photo}
                email={person.data.email}
                researchInterest={person.data.researchInterest}
                startYear={person.data.startYear}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 本科生 Section -->
    {undergrads.length > 0 && (
      <section class="py-12">
        <div class="max-w-7xl mx-auto px-6">
          <h2 class="text-2xl md:text-3xl font-bold mb-8">
            <span class="text-gray-900">本科生</span>
            <span class="text-gray-300 mx-3">|</span>
            <span class="text-amber-600">Undergraduate Students</span>
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {undergrads.map((person) => (
              <PersonCard
                name={person.data.name}
                nameEn={person.data.nameEn}
                role={person.data.role}
                photo={person.data.photo}
                email={person.data.email}
                researchInterest={person.data.researchInterest}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
