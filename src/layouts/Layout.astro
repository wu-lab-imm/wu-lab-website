---
// 导入全局样式
import '../styles/global.css';
import PrivacyAnalytics from '../components/PrivacyAnalytics.astro';

// 定义布局属性
interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
}

// 获取页面属性
const { title, description = 'Wu Lab - Structural Biology Research Group', lang = 'zh' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconHref = `${base}/favicon.svg`;
---

<!DOCTYPE html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title} | Wu Lab</title>

    <!-- 使用本机系统字体，避免外部字体服务阻塞首次渲染。 -->
  </head>
  <body class="bg-white text-gray-900 font-body antialiased">
    <slot />
    <PrivacyAnalytics />
  </body>
</html>
