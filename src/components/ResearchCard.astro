---
// ResearchCard 组件 - 研究方向卡片 (学术精致风格)

interface Props {
  title: string;
  description: string;
  icon?: string;
  link?: string;
}

const { title, description, icon, link } = Astro.props;
---

{link ? (
  <a href={link} class="group block bg-white rounded-sm p-8 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-500 border border-stone-100 hover:border-amber-100">
    <!-- 图标区域 -->
    <div class="w-14 h-14 bg-stone-50 flex items-center justify-center mb-6 group-hover:bg-amber-50 transition-colors duration-300">
      {icon ? (
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">{icon}</span>
      ) : (
        <svg class="w-7 h-7 text-stone-600 group-hover:text-amber-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
        </svg>
      )}
    </div>

    <!-- 标题 -->
    <h3 class="text-xl font-serif text-stone-900 mb-3 group-hover:text-amber-700 transition-colors duration-300">
      {title}
    </h3>

    <!-- 描述 -->
    <p class="text-stone-500 text-sm leading-relaxed mb-4">
      {description}
    </p>

    <!-- 了解更多链接 -->
    <span class="inline-flex items-center text-sm font-medium text-stone-500 group-hover:text-amber-600 transition-colors duration-300">
      了解更多
      <svg class="w-3.5 h-3.5 ml-1 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </span>
  </a>
) : (
  <div class="block bg-white rounded-sm p-8 shadow-sm border border-stone-100">
    <!-- 图标区域 -->
    <div class="w-14 h-14 bg-stone-50 flex items-center justify-center mb-6">
      {icon ? (
        <span class="text-3xl">{icon}</span>
      ) : (
        <svg class="w-7 h-7 text-stone-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
        </svg>
      )}
    </div>

    <!-- 标题 -->
    <h3 class="text-xl font-serif text-stone-900 mb-3">
      {title}
    </h3>

    <!-- 描述 -->
    <p class="text-stone-500 text-sm leading-relaxed">
      {description}
    </p>
  </div>
)}
