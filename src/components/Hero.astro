---
// Hero 组件 - 首页英雄区域 (简洁学术风格)
import { getCollection } from 'astro:content';
import { imageFallbackUrl, imageUrl } from '../lib/images';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Props {
  labName?: string;
  labNameEn?: string;
  subtitle?: string;
  description?: string;
  lang?: 'zh' | 'en';
}

const {
  labName = '吴惊香课题组',
  labNameEn = 'Wu Lab',
  subtitle = '中国医学科学院药物研究所 · 天然药物及核药基础与新药创制全国重点实验室',
  description = '运用冷冻电镜与X射线晶体衍射技术，阐明疾病相关蛋白的工作机制与药物作用机理。',
  lang = 'zh'
} = Astro.props;
const prefix = lang === 'en' ? `${base}/en` : base;
const researchItems = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const primary = researchItems.find((item) => item.data.homeSlot === 'primary') || researchItems[0];
const secondary = researchItems.find((item) => item.data.homeSlot === 'secondary') || researchItems.find((item) => item.slug !== primary?.slug) || primary;
const researchImage = (path: string | undefined, fallback: string) => imageUrl(path || fallback);
const titleFor = (item: typeof primary) => lang === 'en' ? (item?.data.titleEn || item?.data.title) : item?.data.title;
const shortFor = (item: typeof primary) => lang === 'en' ? (item?.data.shortNameEn || item?.data.titleEn || item?.data.title) : (item?.data.shortName || item?.data.title);
---

<section class="relative overflow-hidden bg-[#f7f8fc] pt-24">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_12%_18%,rgba(79,70,229,.12),transparent_32%),radial-gradient(circle_at_88%_72%,rgba(16,185,129,.12),transparent_30%)]"></div>
  <div class="relative max-w-7xl mx-auto px-6 py-20 lg:py-28">
    <div class="grid lg:grid-cols-[1.05fr_.95fr] gap-14 items-center">
      <div class="animate-fade-in-up">
        <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white/80 px-4 py-2 text-xs font-semibold uppercase tracking-[.18em] text-indigo-700 shadow-sm">Structure reveals function</div>
        <h1 class="mt-7 text-6xl md:text-8xl font-display font-bold text-slate-950 tracking-[-.055em] leading-[.9]">{labNameEn}</h1>
        <p class="mt-5 text-2xl md:text-3xl font-semibold text-slate-700">{labName}</p>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-600">{description}</p>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-slate-500">{subtitle}</p>
        <div class="flex flex-wrap gap-3 mt-9">
          <a href={prefix + '/research'} class="rounded-xl bg-indigo-600 px-6 py-3.5 font-semibold text-white shadow-lg shadow-indigo-200 transition hover:-translate-y-0.5 hover:bg-indigo-700">{lang === 'en' ? 'Explore Our Research' : '探索研究方向'}</a>
          <a href={prefix + '/publications'} class="rounded-xl border border-slate-300 bg-white px-6 py-3.5 font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-400">{lang === 'en' ? 'View Publications' : '查看研究成果'}</a>
        </div>
        <div class="mt-12 grid max-w-xl grid-cols-2 gap-3">
          <div class="rounded-2xl border border-indigo-100 bg-indigo-50/80 p-4"><span class="text-xs font-bold uppercase tracking-widest text-indigo-600">Structural Biology</span><p class="mt-2 text-sm text-slate-600">{lang === 'en' ? 'Cryo-EM · Membrane proteins · Structural pharmacology' : '冷冻电镜 · 膜蛋白 · 结构药理学'}</p></div>
          <div class="rounded-2xl border border-emerald-100 bg-emerald-50/80 p-4"><span class="text-xs font-bold uppercase tracking-widest text-emerald-700">Glycobiology</span><p class="mt-2 text-sm text-slate-600">{lang === 'en' ? 'Glycan recognition · Glycosylation · Functional mechanisms' : '糖链识别 · 糖基化 · 功能机制'}</p></div>
        </div>
      </div>
      <div class="relative min-h-[520px] animate-fade-in-up" style="animation-delay:120ms">
        {primary && <a href={`${prefix}/research#${primary.slug}`} class="absolute right-0 top-0 block w-[82%] overflow-hidden rounded-[2rem] border-8 border-white bg-white shadow-2xl shadow-indigo-200/60 transition hover:-translate-y-1">
          <img src={researchImage(primary.data.image, '/images/research/research-1.webp')} data-origin-src={imageFallbackUrl(primary.data.image || '/images/research/research-1.webp')} alt={titleFor(primary)} class="h-80 w-full object-cover object-top" loading="eager" decoding="async" fetchpriority="high" />
          <div class="p-5"><span class="text-xs font-bold uppercase tracking-[.18em] text-indigo-600">{shortFor(primary)}</span><p class="mt-1 font-semibold text-slate-800">{titleFor(primary)}</p></div>
        </a>}
        {secondary && <a href={`${prefix}/research#${secondary.slug}`} class="absolute bottom-0 left-0 block w-[63%] overflow-hidden rounded-[1.75rem] border-8 border-white bg-white shadow-2xl shadow-emerald-200/60 transition hover:-translate-y-1">
          <img src={researchImage(secondary.data.image, '/images/research/glycan-1.webp')} data-origin-src={imageFallbackUrl(secondary.data.image || '/images/research/glycan-1.webp')} alt={titleFor(secondary)} class="h-56 w-full object-cover object-top" loading="lazy" decoding="async" fetchpriority="low" />
          <div class="p-4"><span class="text-xs font-bold uppercase tracking-[.18em] text-emerald-700">{shortFor(secondary)}</span><p class="mt-1 text-sm font-semibold text-slate-800">{titleFor(secondary)}</p></div>
        </a>}
        <div class="absolute bottom-24 right-2 rounded-2xl border border-white bg-slate-950 px-5 py-4 text-white shadow-xl"><span class="block font-mono text-2xl font-semibold">Å</span><span class="text-[10px] uppercase tracking-[.2em] text-slate-400">Atomic insight</span></div>
      </div>
    </div>
  </div>
</section>
