---
// Footer 组件 - 页脚 (简洁学术风格)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { lang?: 'zh' | 'en' }
const { lang = 'zh' } = Astro.props;
const prefix = lang === 'en' ? `${base}/en` : base;

// 快速链接配置
const quickLinks = [
  { href: prefix + '/research', label: lang === 'en' ? 'Research' : '研究方向' },
  { href: prefix + '/people', label: lang === 'en' ? 'People' : '团队成员' },
  { href: prefix + '/publications', label: lang === 'en' ? 'Publications' : '研究成果' },
  { href: prefix + '/news', label: lang === 'en' ? 'News' : '实验室动态' },
  { href: prefix + '/join', label: lang === 'en' ? 'Join Us' : '加入我们' },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-100">
  <div class="border-b border-gray-100 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <p class="mb-7 text-center text-xs font-bold uppercase tracking-[0.2em] text-slate-400">
        {lang === 'en' ? 'Institutional Affiliations' : '所属机构 | Institutional Affiliations'}
      </p>
      <div class="grid gap-5 md:grid-cols-2">
        <a
          href="https://www.pumc.edu.cn/"
          target="_blank"
          rel="noreferrer"
          class="group flex min-h-40 flex-col items-center justify-center rounded-2xl border border-slate-200 bg-white px-7 py-6 text-center shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
          aria-label={lang === 'en' ? 'Visit the PUMC official website' : '访问中国医学科学院北京协和医学院官网'}
        >
          <img
            src={`${base}/images/institutions/pumc-logo.png`}
            alt={lang === 'en' ? 'CAMS & PUMC logo' : '中国医学科学院北京协和医学院徽标'}
            class="h-16 w-full object-contain"
            loading="lazy"
            decoding="async"
          />
          <span class="mt-4 text-sm font-medium text-emerald-800 group-hover:underline">www.pumc.edu.cn ↗</span>
        </a>

        <a
          href="https://www.imm.ac.cn/"
          target="_blank"
          rel="noreferrer"
          class="group flex min-h-40 flex-col items-center justify-center rounded-2xl bg-slate-950 px-7 py-6 text-center shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
          aria-label={lang === 'en' ? 'Visit the IMM official website' : '访问中国医学科学院药物研究所官网'}
        >
          <img
            src={`${base}/images/institutions/imm-logo.png`}
            alt={lang === 'en' ? 'Institute of Materia Medica logo' : '中国医学科学院药物研究所徽标'}
            class="h-16 w-full object-contain"
            loading="lazy"
            decoding="async"
          />
          <span class="mt-4 text-sm font-medium text-slate-300 group-hover:text-white group-hover:underline">www.imm.ac.cn ↗</span>
        </a>
      </div>
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-6 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo & Info -->
      <div class="flex items-center">
        <span class="text-lg font-display font-semibold text-gray-900">
          Wu Lab
        </span>
        <span class="mx-3 text-gray-300">|</span>
        <span class="text-sm text-gray-500">{lang === 'en' ? 'Institute of Materia Medica, CAMS & PUMC' : '中国医学科学院药物研究所'}</span>
      </div>

      <!-- Quick Links -->
      <div class="flex items-center gap-6">
        {quickLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-gray-500 hover:text-amber-600 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Copyright -->
      <div class="text-xs text-gray-400">
        &copy; {currentYear} Wu Lab
      </div>
    </div>
  </div>
</footer>
