---
// Footer 组件 - 页脚 (简洁学术风格)
const base = '/wu-lab-website';

// 快速链接配置
const quickLinks = [
  { href: base + '/research', label: 'Research' },
  { href: base + '/people', label: 'People' },
  { href: base + '/publications', label: 'Publications' },
  { href: base + '/news', label: 'News' },
  { href: base + '/join', label: 'Join' },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-6 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo & Info -->
      <div class="flex items-center">
        <span class="text-lg font-display font-semibold text-gray-900">
          Wu Lab
        </span>
        <span class="mx-3 text-gray-300">|</span>
        <span class="text-sm text-gray-500">Institute of Materia Medica, CAMS</span>
      </div>

      <!-- Quick Links -->
      <div class="flex items-center gap-6">
        {quickLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-gray-500 hover:text-amber-600 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Copyright -->
      <div class="text-xs text-gray-400">
        &copy; {currentYear} Wu Lab
      </div>
    </div>
  </div>
</footer>
